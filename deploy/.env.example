# hookdrop production environment. Copy to /opt/hookdrop/.env on the host,
# fill in the values, then: chown deploy:deploy .env && chmod 600 .env
#
# Names below are every variable main.go reads. Anything left unset falls back
# to a development default, which in production is usually wrong — the five
# LEMONSQUEEZY_* values are checked at boot and reported by warnIfUnset as
# "WARNING: unset config, billing will not work". Check the startup log after
# any change here.
#
# Take the live values from the previous host's compose file, NOT from the
# repo's .env.local: that file holds a mix of live and test credentials, and
# test-mode objects have different IDs to their live counterparts at both
# providers.

# ── Core
# Either a local file (VPS path; requires a cgo build of the image) or a
# libSQL/Turso URL with its auth token inline (Render path; the image is built
# CGO_ENABLED=0 and only accepts this form):
#   DB_PATH=libsql://hookdrop-<org>.turso.io?authToken=eyJ...
DB_PATH=/data/hookdrop.db
PORT=8080
API_URL=https://api.hookdrop.app
FRONTEND_URL=https://hookdrop.app
ALLOWED_ORIGIN=https://hookdrop.app
JWT_SECRET=
APP_VERSION=

# ── Email (Resend)
RESEND_API_KEY=
EMAIL_FROM=hookdrop <noreply@hookdrop.app>

# ── Rate limiting (optional; defaults 30 / 5)
RATE_LIMIT_CAPACITY=
RATE_LIMIT_REFILL=

# ── Lemon Squeezy (USD / international)
# TEST_MODE must match the API key in use. A test key only ever sees test
# data, and product IDs (1249xxx) look deceptively like variant IDs (195xxxx)
# — putting a product ID in a VARIANT var gives a 404 on the variant
# relationship.
LEMONSQUEEZY_TEST_MODE=false
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_WEBHOOK_SECRET=
LEMONSQUEEZY_VARIANT_PRO_MONTHLY=
LEMONSQUEEZY_VARIANT_PRO_ANNUAL=

# ── Paystack (NGN)
PAYSTACK_SECRET_KEY=
PAYSTACK_WEBHOOK_SECRET=
PAYSTACK_PLAN_PRO_MONTHLY=
PAYSTACK_PLAN_PRO_ANNUAL=

# ── Backups (scripts/backup.sh → Cloudflare R2)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
